# LOCAL-ONLY placeholders for docker compose and local development. Never reuse outside this machine.
COMPOSE_PROJECT_NAME=event-registration-attendance
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://event_app:local-only-change-me@127.0.0.1:5433/event_registration_dev?schema=public
TEST_DATABASE_URL=postgresql://event_app:local-only-change-me@127.0.0.1:5434/event_registration_test?schema=public
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Seeding is disabled unless explicitly enabled. Use a local-only password, never a real account password.
ALLOW_DEMO_SEED=0
DEMO_SEED_PASSWORD=

# Destructive reset is disabled unless explicitly enabled for the dedicated test database.
ALLOW_TEST_DB_RESET=0

# --- Deployed container only (Docker / Cloud Run). Leave commented for local development. ---
# The app refuses any database except the two local ones above unless this is 1.
# Cloud Run (Cloud SQL) and Docker Compose set it; never set it on a laptop that also has real data.
# ALLOW_NON_LOCAL_DATABASE=1
# Directory of the built React client; when set, the API also serves the UI from the same origin.
# CLIENT_DIST_DIR=/app/client/dist
# Containers must listen on all interfaces; Cloud Run also sets PORT itself.
# HOST=0.0.0.0
# NODE_ENV=production   # secure cookies; startup fails if DATABASE_URL is missing or rejected
# APP_ORIGIN=https://YOUR-SERVICE-URL.run.app   # must equal the public URL for the Origin check
# Deploy-time seed (`npm run seed --workspace server`): set ALLOW_DEMO_SEED=1 and DEMO_SEED_PASSWORD above.
# In the cloud DATABASE_URL and DEMO_SEED_PASSWORD come from Secret Manager, never from this file.

# --- Browser E2E tests (`npm run test:e2e`). Do not put these in .env. ---
# Set by scripts/run-e2e-tests.mjs to TEST_DATABASE_URL after its safety checks.
# E2E_DATABASE_URL=
# Set by playwright.config.ts so the E2E Vite server proxies /api to the E2E API port (default 3001 for `npm run dev`).
# API_PROXY_TARGET=http://127.0.0.1:3101
# Optional: use an installed browser instead of Playwright's bundled Chromium, e.g. chrome or msedge.
# E2E_BROWSER_CHANNEL=chrome

# Not listed: `import.meta.env.DEV` is set by Vite itself, and `npm_execpath` by npm.
